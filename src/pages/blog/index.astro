---
import { getCollection } from "astro:content"
import type {BlogPost} from "../../content.config"
import BaseLayout from "../../layouts/BaseLayout.astro";
const posts = await getCollection('blog');
const dateTimeFormat = new Intl.DateTimeFormat('en-UK', {
  day: '2-digit',
  month: 'long',
  year: 'numeric'
});
---

<BaseLayout title="Hiddendomain - Blog - Technologies, Games and more" description="Hiddendomain shows blogposts about many topics including technlogies, games and more.">
    <h1>
        Posts
    </h1>
    
    <ul style="list-style: none;">
        {
            posts
            .filter(post => post.data.status === 'published')
            .sort((post_a, post_b) =>  post_b.data.date_created.getTime() - post_a.data.date_created.getTime())
            .map((post) => (
                <li>                    
                    <span>{dateTimeFormat.format(post.data.date_updated ?? post.data.date_created)}</span> 
                    &mdash; 
                    <a href={`/blog/${post.id}`}>
                        <strong>{post.data.title}</strong>
                    </a>
                    <small>
                        {(post.data.seo_text ?? post.data.content).substring(0, 120)}
                    </small>
                </li>
            ))
        }
    </ul>
</BaseLayout>
