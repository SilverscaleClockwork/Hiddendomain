---
import { getCollection } from "astro:content"
import type {BlogPost} from "../../content.config"
import BaseLayout from "../../layouts/BaseLayout.astro";
const posts = await getCollection('blog');
const dateTimeFormat = new Intl.DateTimeFormat('en-UK', {
  day: '2-digit',
  month: 'long',
  year: 'numeric'
});
---

<BaseLayout title="Hiddendomain - Blog - Technologies, Games and more" description="Hiddendomain shows blogposts about many topics including technlogies, games and more.">
    <h1>
        Posts
    </h1>
    
    <ul style="list-style: none;" class="h-feed hfeed">
        {
            posts
            .filter(post => post.data.status === 'published')
            .sort((post_a, post_b) =>  post_b.data.date_created.getTime() - post_a.data.date_created.getTime())
            .map((post) => (
                <li>     
                    <article class="h-entry hentry">
                        <time 
                            class="dt-published published" 
                            datetime={(post.data.date_created).toISOString()}
                        >{dateTimeFormat.format(post.data.date_created)}</time> 
                        &mdash; 
                        <a href={`/blog/${post.id}`} class="u-url" rel="bookmark">
                            <strong>{post.data.title}</strong>
                        </a>
                        <small class="p-summary entry-summary">
                            {(post.data.seo_text ?? post.data.content).substring(0, 120)}
                        </small>
                    </article>               
                </li>
            ))
        }
    </ul>
</BaseLayout>
