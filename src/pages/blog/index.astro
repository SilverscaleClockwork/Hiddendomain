---
import { getCollection } from "astro:content"
import type {BlogPost} from "../../content.config"
import BaseLayout from "../../layouts/BaseLayout.astro";
const posts = await getCollection('blog');
const dateTimeFormat = new Intl.DateTimeFormat('en-UK', {
  day: '2-digit',
  month: 'long',
  year: 'numeric'
});
---

<BaseLayout title="Hiddendomain - Blog - Technologies, Games and more" description="Hiddendomain shows blogposts about many topics including technlogies, games and more.">
	<a href="/">Back</a>

    <h1>
        Posts
    </h1>
    
    <ul>
        {
            posts
            .filter(post => post.data.status === 'published')
            .map((post) => (
                <li>                    
                    <span>{dateTimeFormat.format(post.data.date_updated)}</span> 
                    &mdash; 
                    <a href={`/blog/${post.id}`}>
                        <strong>{post.data.title}</strong>
                    </a>
                    <br />
                    <em>
                        {post.data.content.substring(0, 120)}
                    </em>
                </li>
            ))
        }
    </ul>
</BaseLayout>
