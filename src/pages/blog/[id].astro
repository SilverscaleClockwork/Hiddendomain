---
import { marked } from 'marked';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const dateTimeFormat = new Intl.DateTimeFormat('en-UK', {
  day: '2-digit',
  month: 'long',
  year: 'numeric'
});
const htmlContent = await marked(post.data.content);
---

<BaseLayout title={post.data.title} description={post.data.seo_text || post.data.content}>
  <a href="/blog">Back</a>
  <small>Written {dateTimeFormat.format(post.data.date_updated ?? post.data.date_created)}</small>
  
  <article set:html={htmlContent} />
</BaseLayout>
