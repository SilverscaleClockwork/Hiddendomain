---
import "../styles/global.css"
import "../styles/sakura-dark.css"
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{Astro.props.title}</title>
    <link rel="sitemap" href="https://hiddendoma.in/sitemap-index.xml"/>

    <link rel="preconnect" href="https://unpkg.com" />

    <meta name="description" content={Astro.props.description} />
</head>
<body style="display: flex; flex-direction: column; justify-content: space-between; min-height: 100vh; padding: 0;">
    <main>
        <slot />
    </main>
</body>
</html>
